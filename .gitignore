# Ignore corpus contents except the curated, freely-licensed pure-TeX
# fixtures (corpus/puretex/), which are small tracked test material.
/corpus/*
!/corpus/puretex/
/target/
/bin/aitex
/build/
/dist/
/.aitex/
/.aitex-cache/
**/*.aux
**/*.log
# Knuth's reference transcripts are *source*, not build output. `**/*.log`
# swallowed them, which is why vendor/trip/README.md documented two files that
# were not in the repository: they had been fetched, silently ignored, and lost
# at the next clone. tools/trip.sh needs trip.log to make the canonical
# comparison at all.
!/vendor/trip/*.log
**/*.out
/corpus/meta/ctx/
/corpus/sources/

# Small, licensed, hand-authored 0.3 repair fixtures. Tool transcripts use
# `.txt`, but some broken source products have normally-generated suffixes.
!/corpus/repair-lab/
!/corpus/repair-lab/**
# A fixture build must not turn generated products into new corpus material.
/corpus/repair-lab/**/.aitex/
/corpus/repair-lab/**/*.aux
/corpus/repair-lab/**/*.log
/corpus/repair-lab/**/*.pdf

# generated by the example run
examples/*.dvi
examples/*.pdf

**/*.err

# python bytecode
__pycache__/
*.pyc

# Stray root-level TeX/driver output. Repository scripts must use a temporary
# or explicit output directory; tools/repo_check.sh enforces this list in CI.
/*.dvi
/*.xdv
/*.pdf
/*.fmt
/*.dvitype
/*.semantic
/*.synctex.gz
/*.fls
/*.fdb_latexmk
/*.toc
/*.bbl
/*.blg
/*.idx
/*.ind
/*.ilg
/*.lof
/*.lot
/*.nav
/*.snm
/*.vrb
.claude/
