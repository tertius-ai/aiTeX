      "id": "tex-ini",
      "engine": "tex",
      "format": "source",
      "workflow": "one-shot",
      "commands": {
        "plain:dvi": [
          "tex",
          "-ini",
          "-interaction=nonstopmode",
          "-halt-on-error",
          "{root}"
        ]
      }
    },
    {
