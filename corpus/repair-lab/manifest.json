{
  "schema": "aitex-repair-corpus-v1",
  "cases": [
    {
      "id": "tex-unknown-command",
      "tool": "tex",
      "log": "cases/tex-unknown-command/diagnostic.txt",
      "root": "cases/tex-unknown-command/main.tex",
      "source": "cases/tex-unknown-command/main.tex",
      "fixed": "cases/tex-unknown-command/fixed.tex",
      "expected_kind": "undefined-control-sequence",
      "expected_file": "main.tex",
      "expected_line": 19,
      "expected_route": "model",
      "repair": "Replace the project-specific misspelling \\widgitize with the intended command or define it."
    },
    {
      "id": "tex-unclosed-brace",
      "tool": "tex",
      "log": "cases/tex-unclosed-brace/diagnostic.txt",
      "root": "cases/tex-unclosed-brace/main.tex",
      "source": "cases/tex-unclosed-brace/main.tex",
      "fixed": "cases/tex-unclosed-brace/fixed.tex",
      "expected_kind": "runaway-argument",
      "expected_file": null,
      "expected_line": null,
      "expected_route": "model",
      "repair": "Close the textbf group on line 3."
    },
    {
      "id": "tex-missing-graphicx",
      "tool": "tex",
      "log": "cases/tex-missing-graphicx/diagnostic.txt",
      "root": "cases/tex-missing-graphicx/main.tex",
      "source": "cases/tex-missing-graphicx/main.tex",
      "fixed": "cases/tex-missing-graphicx/fixed.tex",
      "expected_kind": "undefined-control-sequence",
      "expected_file": "main.tex",
      "expected_line": 3,
      "expected_route": "deterministic",
      "repair": "Load graphicx before using rotatebox."
    },
    {
      "id": "bibtex-missing-comma",
      "tool": "bibtex",
      "log": "cases/bibtex-missing-comma/diagnostic.txt",
      "root": "cases/bibtex-missing-comma/main.tex",
      "source": "cases/bibtex-missing-comma/refs.bib",
      "fixed": "cases/bibtex-missing-comma/fixed.bib",
      "expected_kind": "bibliography",
      "expected_file": "refs.bib",
      "expected_line": 4,
      "expected_route": "deterministic",
      "repair": "Add the comma after the title field."
    },
    {
      "id": "biber-unclosed-entry",
      "tool": "biber",
      "log": "cases/biber-unclosed-entry/diagnostic.txt",
      "root": "cases/biber-unclosed-entry/main.tex",
      "source": "cases/biber-unclosed-entry/refs.bib",
      "fixed": "cases/biber-unclosed-entry/fixed.bib",
      "expected_kind": "bibliography",
      "expected_file": "refs.bib",
      "expected_line": 3,
      "expected_route": "model",
      "repair": "Close the author value before the title field."
    },
    {
      "id": "makeindex-null-field",
      "tool": "makeindex",
      "log": "cases/makeindex-null-field/diagnostic.txt",
      "root": "cases/makeindex-null-field/main.tex",
      "source": "cases/makeindex-null-field/main.idx",
      "project_source": "cases/makeindex-null-field/main.tex",
      "fixed": "cases/makeindex-null-field/fixed.tex",
      "expected_kind": "index",
      "expected_file": "main.idx",
      "expected_line": 2,
      "cause_file": "main.tex",
      "cause_line": 7,
      "expected_route": "model",
      "repair": "Give the second index entry a non-empty key."
    },
    {
      "id": "makeglossaries-null-field",
      "tool": "makeglossaries",
      "log": "cases/makeglossaries-null-field/diagnostic.txt",
      "root": "cases/makeglossaries-null-field/main.tex",
      "source": "cases/makeglossaries-null-field/terms.glo",
