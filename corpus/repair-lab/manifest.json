      "fixed": "cases/makeglossaries-null-field/fixed.tex",
      "expected_kind": "glossary",
      "expected_file": "terms.glo",
      "expected_line": 2,
      "cause_file": "main.tex",
      "cause_line": 5,
      "expected_route": "model",
      "repair": "Restore the missing glossary sort key."
    },
    {
      "id": "nomenclature-null-field",
      "tool": "nomenclature",
      "log": "cases/nomenclature-null-field/diagnostic.txt",
      "root": "cases/nomenclature-null-field/main.tex",
      "source": "cases/nomenclature-null-field/symbols.nlo",
      "project_source": "cases/nomenclature-null-field/main.tex",
      "fixed": "cases/nomenclature-null-field/fixed.tex",
      "expected_kind": "glossary",
      "expected_file": "symbols.nlo",
      "expected_line": 2,
      "cause_file": "main.tex",
      "cause_line": 5,
      "expected_route": "model",
